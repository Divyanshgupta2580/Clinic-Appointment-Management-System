# ==============================================================================
# MediPulse Clinic — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Environment (backend/.env)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clinic_appointment_db
SESSION_SECRET=<secure_random_64_character_hex_string>
FRONTEND_URL=https://<your-frontend-service>.onrender.com

# ------------------------------------------------------------------------------
# Frontend Service Environment (frontend/.env.local / Render Environment)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://<your-backend-service>.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://<your-backend-service>.onrender.com
