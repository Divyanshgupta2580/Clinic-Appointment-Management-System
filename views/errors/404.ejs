<%- include('../partials/header', { title: '404 Not Found' }) %>

<div class="error-page">
  <div class="error-card">
    <div class="error-code">404</div>
    <h1 class="error-title">Page Not Found</h1>
    <p class="error-description">
      The medical resource or page you requested <%= typeof path !== 'undefined' ? '(' + path + ')' : '' %> could not be located on the server.
    </p>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">
        <i data-lucide="home" class="icon-sm"></i>
        <span>Return Home</span>
      </a>
      <a href="/patient/doctors" class="btn btn-outline">
        <i data-lucide="search" class="icon-sm"></i>
        <span>Find Doctors</span>
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
