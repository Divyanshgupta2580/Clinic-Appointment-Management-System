<%- include('../partials/header', { title: '403 Forbidden' }) %>

<div class="error-page">
  <div class="error-card">
    <div class="error-code">403</div>
    <h1 class="error-title">Access Denied</h1>
    <p class="error-description">
      <%= typeof message !== 'undefined' ? message : 'You do not have authorization to access this healthcare dashboard or resource.' %>
    </p>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">Return Home</a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <% if (currentUser.role === 'patient') { %>
          <a href="/patient/dashboard" class="btn btn-outline">Patient Dashboard</a>
        <% } else if (currentUser.role === 'doctor') { %>
          <a href="/doctor/dashboard" class="btn btn-outline">Doctor Dashboard</a>
        <% } else if (currentUser.role === 'admin') { %>
          <a href="/admin/dashboard" class="btn btn-outline">Admin Dashboard</a>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
