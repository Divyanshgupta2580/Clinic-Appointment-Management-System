<%- include('../partials/header', { title: '500 Server Error' }) %>

<div class="error-page">
  <div class="error-card">
    <div class="error-code">500</div>
    <h1 class="error-title">Internal Server Error</h1>
    <p class="error-description">
      <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred on our clinic server. Our technical team has been notified.' %>
    </p>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">Return Home</a>
      <button onclick="window.history.back()" class="btn btn-outline">Go Back</button>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
