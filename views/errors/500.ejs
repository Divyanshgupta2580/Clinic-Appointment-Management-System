<%- include('../partials/header', { title: '500 Server Error' }) %>

<div class="error-page">
  <div class="error-card">
    <div class="error-code">500</div>
    <h1 class="error-title">Internal Server Error</h1>
    <p class="error-description">
      <%= typeof message !== 'undefined' ? message : 'An unexpected server error occurred during clinical data processing. Our technical team has been notified.' %>
    </p>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">
        <i data-lucide="home" class="icon-sm"></i>
        <span>Return Home</span>
      </a>
      <button onclick="window.history.back()" class="btn btn-outline">
        <i data-lucide="arrow-left" class="icon-sm"></i>
        <span>Go Back</span>
      </button>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
