<%- include('../partials/header', { title: 'Appointment Details' }) %>

<div class="page-header">
  <div>
    <% if (currentUser.role === 'patient') { %>
      <a href="/patient/appointments" class="btn btn-ghost btn-sm" style="margin-bottom: 0.5rem;">← Back to My Appointments</a>
    <% } else { %>
      <a href="/doctor/appointments" class="btn btn-ghost btn-sm" style="margin-bottom: 0.5rem;">← Back to Appointments</a>
    <% } %>
    <h1 class="page-title">Appointment Details</h1>
    <p class="page-subtitle">ID: #<%= appointment._id %></p>
  </div>

  <div>
    <%- include('../partials/statusBadge', { status: appointment.status }) %>
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
  <!-- Appointment Information Card -->
  <div class="card" data-appointment-id="<%= appointment._id %>">
    <div class="card-header">
      <h2 class="card-title">Schedule Information</h2>
    </div>

    <ul class="doctor-details-list" style="font-size: 1rem; gap: 0.85rem;">
      <li><strong>Date:</strong> <%= appointment.appointmentDate %></li>
      <li><strong>Time Slot:</strong> <%= appointment.appointmentTime %></li>
      <li>
        <strong>Status:</strong> 
        <span data-appointment-badge="<%= appointment._id %>">
          <%- include('../partials/statusBadge', { status: appointment.status }) %>
        </span>
      </li>
      <li><strong>Booked On:</strong> <%= new Date(appointment.createdAt).toLocaleString() %></li>
      <li><strong>Last Updated:</strong> <%= new Date(appointment.updatedAt).toLocaleString() %></li>
      <li><strong>Notes / Symptoms:</strong> <%= appointment.notes || 'None provided' %></li>
    </ul>

    <!-- Action Buttons -->
    <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color);" data-appointment-actions="<%= appointment._id %>">
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <% if (isDoctorAssigned || isAdmin) { %>
          <% if (appointment.status === 'pending') { %>
            <form action="/appointments/<%= appointment._id %>/accept" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-success">Accept Appointment</button>
            </form>
            <form action="/appointments/<%= appointment._id %>/reject" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-danger">Decline Appointment</button>
            </form>
          <% } else if (appointment.status === 'accepted') { %>
            <form action="/appointments/<%= appointment._id %>/complete" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-accent">Mark Completed</button>
            </form>
          <% } %>
        <% } %>

        <% if ((isPatientOwner || isDoctorAssigned || isAdmin) && (appointment.status === 'pending' || appointment.status === 'accepted')) { %>
          <form action="/appointments/<%= appointment._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this appointment?');" style="display: inline;">
            <button type="submit" class="btn btn-outline" style="color: var(--danger); border-color: var(--danger);">Cancel Appointment</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Participants Information -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Patient Info -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Patient Profile</h2>
      </div>
      <p style="font-size: 1.1rem; font-weight: 700;"><%= appointment.patientId ? appointment.patientId.name : 'Unknown' %></p>
      <p class="text-muted"><%= appointment.patientId ? appointment.patientId.email : '—' %></p>
    </div>

    <!-- Doctor Info -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Consulting Physician</h2>
      </div>
      <p style="font-size: 1.1rem; font-weight: 700;">Dr. <%= appointment.doctorId ? appointment.doctorId.name : 'Unknown' %></p>
      <p class="doctor-spec"><%= doctorProfile ? doctorProfile.specialization : 'General Practice' %></p>
      <p style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 0.35rem;">
        Qualification: <%= doctorProfile ? doctorProfile.qualification : 'MBBS' %> • 
        Experience: <%= doctorProfile ? doctorProfile.experience : 1 %> Yrs
      </p>
      <p class="text-muted" style="font-size: 0.85rem; margin-top: 0.25rem;"><%= appointment.doctorId ? appointment.doctorId.email : '—' %></p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
