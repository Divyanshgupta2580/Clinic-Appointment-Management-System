<%- include('../partials/header', { title: 'Patient Dashboard' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Welcome, <%= currentUser.name %></h1>
    <p class="page-subtitle">Track your upcoming visits and clinical consultations</p>
  </div>
  <a href="/patient/doctors" class="btn btn-primary btn-lg">
    <i data-lucide="plus"></i>
    <span>Book New Appointment</span>
  </a>
</div>

<!-- Quick Stats -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon accepted">
      <i data-lucide="calendar"></i>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.upcomingCount %></div>
      <div class="stat-label">Upcoming Appointments</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon pending">
      <i data-lucide="clock"></i>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.pendingCount %></div>
      <div class="stat-label">Pending Confirmation</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">
      <i data-lucide="clipboard-list"></i>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.totalBookings %></div>
      <div class="stat-label">Total Visits Booked</div>
    </div>
  </div>
</div>

<!-- Recent Appointments Table -->
<div class="card">
  <div class="card-header">
    <h2 class="card-title">Recent Appointments</h2>
    <a href="/patient/appointments" class="btn btn-ghost btn-sm">
      <span>View All History</span>
      <i data-lucide="arrow-right" class="icon-sm"></i>
    </a>
  </div>

  <% if (recentAppointments && recentAppointments.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Doctor</th>
            <th>Specialization</th>
            <th>Date</th>
            <th>Time</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="appointmentsTableBody">
          <% recentAppointments.forEach(apt => { %>
            <tr data-appointment-id="<%= apt._id %>">
              <td>
                <strong>Dr. <%= apt.doctorId ? apt.doctorId.name : 'Clinic Doctor' %></strong>
              </td>
              <td>
                <span class="badge badge-accent">
                  <%= apt.specialization %>
                </span>
              </td>
              <td><%= apt.appointmentDate %></td>
              <td><strong><%= apt.appointmentTime %></strong></td>
              <td>
                <%- include('../partials/statusBadge', { status: apt.status }) %>
              </td>
              <td>
                <a href="/appointments/<%= apt._id %>" class="btn btn-outline btn-sm">
                  <span>Details</span>
                  <i data-lucide="chevron-right" class="icon-sm"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 3rem 1rem;">
      <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--bg-subtle); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto; color: var(--text-muted);">
        <i data-lucide="calendar-x" class="icon-lg"></i>
      </div>
      <p style="font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 1.25rem;">You don't have any appointments scheduled yet.</p>
      <a href="/patient/doctors" class="btn btn-primary">
        <i data-lucide="search" class="icon-sm"></i>
        <span>Find a Doctor & Book Now</span>
      </a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
