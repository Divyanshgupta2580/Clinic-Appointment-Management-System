<%- include('../partials/header', { title: 'Book Appointment - Dr. ' + doctor.name }) %>

<div class="page-header">
  <div>
    <a href="/patient/doctors" class="btn btn-ghost btn-sm" style="margin-bottom: 0.6rem;">
      <i data-lucide="arrow-left" class="icon-sm"></i>
      <span>Back to Doctors</span>
    </a>
    <h1 class="page-title">Book an Appointment</h1>
    <p class="page-subtitle">Schedule your consultation with Dr. <%= doctor.name %></p>
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: start;">
  <!-- Doctor Summary Card -->
  <div class="card">
    <div class="doctor-avatar" style="width: 72px; height: 72px; font-size: 1.75rem;">
      <%= doctor.name.charAt(0).toUpperCase() %>
    </div>
    <h2 style="font-size: 1.4rem; font-weight: 700; color: var(--text-primary);">Dr. <%= doctor.name %></h2>
    <div class="doctor-spec" style="font-size: 1rem; margin-bottom: 1.25rem;">
      <i data-lucide="activity" class="icon-sm"></i>
      <span><%= profile.specialization %></span>
    </div>

    <ul class="doctor-details-list" style="font-size: 0.95rem; gap: 0.75rem;">
      <li><strong>Qualification:</strong> <%= profile.qualification %></li>
      <li><strong>Experience:</strong> <%= profile.experience %>+ Years in Practice</li>
      <li><strong>Consultation Length:</strong> <%= profile.consultationDuration || 30 %> Minutes</li>
      <li><strong>Weekly Schedule:</strong> <%= profile.availableDays ? profile.availableDays.join(', ') : 'Mon - Fri' %></li>
      <li><strong>Working Hours:</strong> <%= profile.availableStartTime %> to <%= profile.availableEndTime %></li>
      <li><strong>Clinic Contact:</strong> <%= doctor.email %></li>
    </ul>

    <div class="alert alert-info" style="margin-top: 1.5rem; margin-bottom: 0;">
      <span class="alert-icon">
        <i data-lucide="shield-check"></i>
      </span>
      <div class="alert-body">
        <p>MediPulse enforces atomic zero double-booking locks. Slots are reserved instantly upon confirmation.</p>
      </div>
    </div>
  </div>

  <!-- Booking Form Card -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Select Date & Time Slot</h2>
    </div>

    <form action="/appointments/book" method="POST" id="appointmentBookingForm">
      <input type="hidden" name="doctorId" value="<%= doctor._id %>">
      <input type="hidden" name="appointmentTime" id="appointmentTime" value="<%= preselectedTime %>" required>

      <div class="form-group">
        <label for="appointmentDate" class="form-label">Select Consultation Date</label>
        <input 
          type="date" 
          id="appointmentDate" 
          name="appointmentDate" 
          class="form-control" 
          data-doctor-id="<%= doctor._id %>" 
          value="<%= preselectedDate %>"
          required
        >
        <span class="form-text">Choose a date to view available time slots.</span>
      </div>

      <div class="form-group">
        <label class="form-label">Available Time Slots</label>
        <div id="slotsContainer" class="slots-container">
          <p class="text-muted" style="grid-column: 1/-1; padding: 1rem 0;">
            Please select a date above to display available slots.
          </p>
        </div>
        <div id="slotMessage" style="font-size: 0.875rem; font-weight: 600; margin-top: 0.5rem; color: var(--primary);"></div>
      </div>

      <div class="form-group">
        <label for="notes" class="form-label">Reason for Visit / Symptoms (Optional)</label>
        <textarea 
          id="notes" 
          name="notes" 
          class="form-control" 
          rows="3" 
          placeholder="Briefly describe your symptoms or reason for visit..."
          maxlength="500"
        ></textarea>
      </div>

      <button type="submit" id="bookSubmitBtn" class="btn btn-primary btn-block btn-lg" disabled>
        <i data-lucide="check-circle" class="icon-sm"></i>
        <span>Confirm & Book Appointment</span>
      </button>
    </form>
  </div>
</div>

<script src="/js/booking.js"></script>

<%- include('../partials/footer') %>
