<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | MediPulse Clinic' : 'MediPulse Clinic | Appointment Management' %></title>
  <meta name="description" content="A reliable, modern Clinic Appointment Management System for doctors and patients.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <script>
      window.CURRENT_USER = {
        id: "<%= currentUser._id %>",
        role: "<%= currentUser.role %>",
        name: "<%= currentUser.name %>"
      };
    </script>
  <% } else { %>
    <script>
      window.CURRENT_USER = null;
    </script>
  <% } %>
</head>
<body>
  <%- include('./navbar') %>
  <main class="main-content">
    <div class="container">
      <%- include('./flash') %>
