<%- include('./partials/header', { title: 'MediPulse Clinic - Modern Healthcare Management' }) %>

<!-- HERO SECTION -->
<section style="padding: 2.5rem 0 3.5rem 0; text-align: center;">
  <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 1rem; background-color: var(--primary-light); color: var(--info-text); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem;">
    <i data-lucide="shield-check" class="icon-sm"></i>
    <span>Enterprise Clinical Appointment Infrastructure</span>
  </div>

  <h1 style="font-size: 3rem; font-weight: 800; color: var(--text-primary); line-height: 1.15; letter-spacing: -0.035em; max-width: 860px; margin: 0 auto 1.25rem auto;">
    Precision Healthcare Scheduling with Zero Double-Booking
  </h1>

  <p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 700px; margin: 0 auto 2.25rem auto; line-height: 1.6;">
    Connecting patients and clinical specialists with guaranteed conflict-free slot reservation, instant next-available suggestions, and enterprise-grade role security.
  </p>

  <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <% if (currentUser.role === 'patient') { %>
        <a href="/patient/dashboard" class="btn btn-primary btn-lg">
          <i data-lucide="layout-dashboard"></i>
          <span>Patient Dashboard</span>
        </a>
        <a href="/patient/doctors" class="btn btn-outline btn-lg">
          <i data-lucide="stethoscope"></i>
          <span>Browse Specialists</span>
        </a>
      <% } else if (currentUser.role === 'doctor') { %>
        <a href="/doctor/dashboard" class="btn btn-primary btn-lg">
          <i data-lucide="layout-dashboard"></i>
          <span>Doctor Dashboard</span>
        </a>
        <a href="/doctor/appointments" class="btn btn-outline btn-lg">
          <i data-lucide="calendar-check"></i>
          <span>Manage Schedule</span>
        </a>
      <% } else if (currentUser.role === 'admin') { %>
        <a href="/admin/dashboard" class="btn btn-primary btn-lg">
          <i data-lucide="shield"></i>
          <span>Admin Command Center</span>
        </a>
      <% } %>
    <% } else { %>
      <a href="/patient/doctors" class="btn btn-primary btn-lg">
        <i data-lucide="calendar"></i>
        <span>Book an Appointment</span>
      </a>
      <a href="/auth/register" class="btn btn-accent btn-lg">
        <i data-lucide="user-plus"></i>
        <span>Create Patient Account</span>
      </a>
      <a href="/auth/login" class="btn btn-outline btn-lg">
        <i data-lucide="log-in"></i>
        <span>Physician / Admin Sign In</span>
      </a>
    <% } %>
  </div>
</section>

<!-- PLATFORM METRICS -->
<div class="stats-grid" style="margin-bottom: 3.5rem;">
  <div class="stat-card">
    <div class="stat-icon accepted">
      <i data-lucide="stethoscope"></i>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.totalDoctors %>+</div>
      <div class="stat-label">Verified Specialists</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">
      <i data-lucide="calendar-check"></i>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.totalAppointments %>+</div>
      <div class="stat-label">Consultations Handled</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon pending">
      <i data-lucide="users"></i>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.totalPatients %>+</div>
      <div class="stat-label">Registered Patients</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon completed">
      <i data-lucide="lock"></i>
    </div>
    <div class="stat-info">
      <div class="stat-value">100%</div>
      <div class="stat-label">Zero Double-Booking Rate</div>
    </div>
  </div>
</div>

<!-- DOCTOR DISCOVERY & SEARCH BAR -->
<div class="card" style="margin-bottom: 3.5rem; background: var(--bg-surface); border: 1px solid var(--border-color); padding: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--text-primary); letter-spacing: -0.02em;">Find Clinical Specialists</h2>
      <p style="color: var(--text-secondary); font-size: 0.9rem;">Search by physician name or choose a specialized clinical department</p>
    </div>
    <a href="/patient/doctors" class="btn btn-outline btn-sm">
      <span>View All Physicians</span>
      <i data-lucide="arrow-right" class="icon-sm"></i>
    </a>
  </div>

  <form action="/patient/doctors" method="GET" style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
    <div style="flex: 1; min-width: 260px;">
      <input 
        type="text" 
        name="search" 
        class="form-control" 
        placeholder="Search doctor name or specialty (e.g. Cardiologist, Dr. Vance)..."
      >
    </div>
    <button type="submit" class="btn btn-primary" style="height: 44px;">
      <i data-lucide="search" class="icon-sm"></i>
      <span>Search Directory</span>
    </button>
  </form>

  <!-- Popular Specialties Quick-Filters -->
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
    <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-right: 0.25rem;">Popular Departments:</span>
    <% const popularSpecs = ['Cardiology', 'Dermatology', 'Orthopedics', 'Pediatrics', 'General Medicine', 'Neurology', 'Psychiatry']; %>
    <% popularSpecs.forEach(spec => { %>
      <a href="/patient/doctors?specialization=<%= encodeURIComponent(spec) %>" class="badge badge-accent" style="text-decoration: none; padding: 0.35rem 0.75rem; font-size: 0.78rem;">
        <%= spec %>
      </a>
    <% }) %>
  </div>
</div>

<!-- FEATURED DOCTORS PREVIEW -->
<% if (featuredDoctors && featuredDoctors.length > 0) { %>
  <div style="margin-bottom: 3.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <div>
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em;">Featured Medical Faculty</h2>
        <p style="color: var(--text-secondary); font-size: 0.925rem;">Consult with our top-rated specialists across primary and advanced medicine</p>
      </div>
      <a href="/patient/doctors" class="btn btn-ghost btn-sm">
        <span>Browse Complete Roster</span>
        <i data-lucide="arrow-right" class="icon-sm"></i>
      </a>
    </div>

    <div class="doctors-grid">
      <% featuredDoctors.forEach(doc => { %>
        <div class="doctor-card">
          <div>
            <div class="doctor-avatar">
              <%= doc.userId ? doc.userId.name.charAt(0).toUpperCase() : 'D' %>
            </div>
            <h3 class="doctor-name">Dr. <%= doc.userId ? doc.userId.name : 'Physician' %></h3>
            <div class="doctor-spec">
              <i data-lucide="activity" class="icon-sm"></i>
              <span><%= doc.specialization %></span>
            </div>

            <ul class="doctor-details-list">
              <li><strong>Qualification:</strong> <%= doc.qualification %></li>
              <li><strong>Experience:</strong> <%= doc.experience %>+ Years in Practice</li>
              <li><strong>Consultation Hours:</strong> <%= doc.availableStartTime %> - <%= doc.availableEndTime %></li>
              <li><strong>Available Days:</strong> <%= doc.availableDays ? doc.availableDays.slice(0, 3).join(', ') + (doc.availableDays.length > 3 ? '...' : '') : 'Mon - Fri' %></li>
            </ul>
          </div>

          <div style="margin-top: 1rem; border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
            <a href="/patient/doctors/<%= doc.userId ? doc.userId._id : '' %>" class="btn btn-primary btn-block">
              <i data-lucide="calendar" class="icon-sm"></i>
              <span>Book Appointment</span>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<!-- HOW IT WORKS (3-STEP CLINICAL WORKFLOW) -->
<div style="margin-bottom: 3.5rem;">
  <div style="text-align: center; margin-bottom: 2rem;">
    <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em;">How MediPulse Works</h2>
    <p style="color: var(--text-secondary); font-size: 0.95rem;">Streamlined 3-step appointment workflow for patients and physicians</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
    <div class="card" style="text-align: center; padding: 2rem 1.5rem;">
      <div style="width: 50px; height: 50px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto; font-size: 1.25rem;">
        <i data-lucide="search"></i>
      </div>
      <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">1. Select Specialist</h3>
      <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5;">
        Browse verified medical practitioners by clinical specialty, qualifications, experience, and weekly hours.
      </p>
    </div>

    <div class="card" style="text-align: center; padding: 2rem 1.5rem;">
      <div style="width: 50px; height: 50px; border-radius: 50%; background: var(--accent-light); color: var(--accent); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto; font-size: 1.25rem;">
        <i data-lucide="calendar-check"></i>
      </div>
      <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">2. Pick Live Slot</h3>
      <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5;">
        View real-time doctor availability. Our atomic compound lock prevents race-condition double bookings.
      </p>
    </div>

    <div class="card" style="text-align: center; padding: 2rem 1.5rem;">
      <div style="width: 50px; height: 50px; border-radius: 50%; background: var(--success-bg); color: var(--success); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto; font-size: 1.25rem;">
        <i data-lucide="check-circle-2"></i>
      </div>
      <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">3. Verified Visit</h3>
      <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5;">
        Physicians review and confirm consultations. Patients track visit history with detailed appointment states.
      </p>
    </div>
  </div>
</div>

<!-- ARCHITECTURE & PLATFORM PILLARS -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-bottom: 3.5rem;">
  <div class="card">
    <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
      <i data-lucide="shield"></i>
    </div>
    <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">Zero Double-Booking</h3>
    <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.55;">
      Enforced at the MongoDB engine layer with compound unique indexes on <code>(doctorId, appointmentDate, appointmentTime)</code>.
    </p>
  </div>

  <div class="card">
    <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: var(--accent-light); color: var(--accent); display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
      <i data-lucide="zap"></i>
    </div>
    <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">Server-Side Rendered (SSR)</h3>
    <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.55;">
      Express + EJS architecture delivers fast, secure, search-engine accessible HTML pages with zero client-side hydration bloat.
    </p>
  </div>

  <div class="card">
    <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: var(--warning-bg); color: var(--warning); display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
      <i data-lucide="clock"></i>
    </div>
    <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">Next Slot Intelligence</h3>
    <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.55;">
      If a slot is claimed simultaneously, our algorithm immediately computes the next available opening for a frictionless booking experience.
    </p>
  </div>

  <div class="card">
    <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: rgba(168, 85, 247, 0.15); color: #c084fc; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
      <i data-lucide="lock"></i>
    </div>
    <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">Enterprise Security</h3>
    <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.55;">
      Granular Role-Based Access Control (Patient, Doctor, Admin), bcrypt password encryption, Helmet headers, and rate limiting.
    </p>
  </div>
</div>

<!-- PHYSICIAN RECRUITMENT CALL-TO-ACTION -->
<div class="card" style="text-align: center; padding: 3rem 1.5rem; background: linear-gradient(135deg, var(--bg-surface), var(--bg-elevated)); border: 1px solid var(--border-subtle); margin-bottom: 1rem;">
  <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--accent-light); color: var(--accent); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
    <i data-lucide="stethoscope" class="icon-lg"></i>
  </div>
  <h2 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.6rem; color: var(--text-primary); letter-spacing: -0.02em;">Are you a Physician joining MediPulse?</h2>
  <p style="color: var(--text-secondary); max-width: 560px; margin: 0 auto 1.75rem auto; line-height: 1.6;">
    Register your physician profile, configure your consultation duration and weekly shift hours, and manage patient appointments with real-time slot control.
  </p>
  <div style="display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap;">
    <a href="/auth/register" class="btn btn-accent btn-lg">
      <i data-lucide="user-plus" class="icon-sm"></i>
      <span>Register as Doctor</span>
    </a>
    <a href="/auth/login" class="btn btn-outline btn-lg">
      <i data-lucide="log-in" class="icon-sm"></i>
      <span>Doctor Portal Login</span>
    </a>
  </div>
</div>

<%- include('./partials/footer') %>
